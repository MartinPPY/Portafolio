---
---

<section id="inicio" class="flex min-h-[calc(100vh-2rem)] flex-col items-center justify-center gap-12 py-12 md:flex-row md:justify-between">
  <div class="max-w-2xl flex-1">
    <h1 class="text-4xl font-bold leading-tight text-heading md:text-5xl">
      Ingeniero DevOps &amp; <br class="hidden md:block" />
      <span class="text-fg-brand">Especialista en IA</span>
    </h1>
    <p class="mt-6 max-w-2xl text-lg text-body">
      Automatizando el futuro con arquitecturas escalables e inteligencia artificial aplicada.
      Construyendo automatizaciones robustas y soluciones de soporte con IA para entornos de alto rendimiento.
    </p>
    <div class="mt-10 flex flex-wrap items-center gap-4">
      <a
        href="#proyectos"
        class="group inline-flex items-center gap-2 rounded-base bg-fg-brand px-8 py-4 font-medium text-white shadow-lg transition-colors hover:bg-fg-brand-strong"
      >
        Ver Proyectos
        <span class="material-symbols-outlined transition-transform group-hover:translate-x-1">arrow_forward</span>
      </a>
      <a
        href="/MARTIN_ROMERO_CV.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-base border border-default px-8 py-4 font-medium text-heading transition-colors hover:bg-neutral-tertiary"
      >
        Ver CV
        <span class="material-symbols-outlined text-[20px]">description</span>
      </a>
    </div>
  </div>

  <div class="w-full max-w-lg flex-1">
    <div class="rounded-xl border border-default bg-dark-backdrop p-6 shadow-2xl">
      <div class="mb-6 flex items-center justify-between border-b border-white/10 pb-4">
        <div class="flex gap-2">
          <span class="h-3 w-3 rounded-full bg-red-500/80"></span>
          <span class="h-3 w-3 rounded-full bg-yellow-500/80"></span>
          <span class="h-3 w-3 rounded-full bg-green-500/80"></span>
        </div>
        <span class="font-mono text-xs text-gray-400">tech_stack.yaml</span>
      </div>
      <div class="space-y-4 font-mono text-sm leading-relaxed text-gray-300">
        <div>
          <div class="text-purple-400">infrastructure:</div>
          <div class="mt-2 flex flex-wrap gap-2 pl-4">
            <span class="rounded bg-gray-800 px-2 py-1 text-sky-400">Terraform</span>
            <span class="rounded bg-gray-800 px-2 py-1 text-sky-400">Kubernetes</span>
            <span class="rounded bg-gray-800 px-2 py-1 text-sky-400">Docker</span>
            <span class="rounded bg-gray-800 px-2 py-1 text-sky-400">AWS</span>
            <span class="rounded bg-gray-800 px-2 py-1 text-sky-400">GCP</span>
          </div>
        </div>
        <div>
          <div class="text-purple-400">stack:</div>
          <div class="mt-2 flex flex-wrap gap-2 pl-4">
            <span class="rounded bg-gray-800 px-2 py-1 text-emerald-400">Python</span>
            <span class="rounded bg-gray-800 px-2 py-1 text-emerald-400">Node.js</span>
            <span class="rounded bg-gray-800 px-2 py-1 text-emerald-400">PHP</span>
            <span class="rounded bg-gray-800 px-2 py-1 text-emerald-400">React</span>
            <span class="rounded bg-gray-800 px-2 py-1 text-emerald-400">JavaScript</span>
            <span class="rounded bg-gray-800 px-2 py-1 text-emerald-400">Java</span>
            <span class="rounded bg-gray-800 px-2 py-1 text-emerald-400">Angular</span>
            <span class="rounded bg-gray-800 px-2 py-1 text-emerald-400">Astro</span>
          </div>
        </div>
        <div>
          <div class="text-purple-400">pipeline:</div>
          <div class="mt-2 flex flex-wrap gap-2 pl-4">
            <span class="rounded bg-gray-800 px-2 py-1 text-gray-200">GitLab CI</span>
            <span class="rounded bg-gray-800 px-2 py-1 text-gray-200">GitHub Actions</span>
          </div>
        </div>
      </div>
      <div class="mt-4 flex items-center gap-2">
        <span class="font-mono text-sky-400">&gt;</span>
        <span class="h-4 w-2 animate-pulse bg-gray-200"></span>
      </div>
    </div>
  </div>
</section>
