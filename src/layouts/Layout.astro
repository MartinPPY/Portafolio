---
import "../styles/global.css";
import Seo from "../components/Seo.astro";
import TopControls from "../components/TopControls.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Martín Romero | Analista Programador & Automatización",
  description = "Portafolio de Martín Romero, Analista Programador especializado en automatización de procesos, integración de IA y soporte técnico de sistemas.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <Seo title={title} description={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=JetBrains+Mono&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-neutral-primary-soft font-body text-body">
    <TopControls />
    <slot />
    <script
      is:inline
      src="https://cdn.jsdelivr.net/npm/flowbite@4.0.1/dist/flowbite.min.js"
    ></script>
  </body>
</html>
